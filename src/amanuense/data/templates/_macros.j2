{# Building blocks shared by the shipped Markdown templates. Import with
   {% import "_macros.j2" as x %} and call e.g. {{ x.todo(m) }}. #}

{% macro task_note(t, followup=false, earlier=none) -%}
{% if t == "added" %} · {{ "follow-up task" if followup else "task" }} added{% if earlier %} (an earlier task was {{ "done" if earlier == "completed" else "deleted" }}){% endif %}{% elif t == "would add" %} · task (dry run){% elif t == "exists" %} · task exists{% elif t == "noted" %} · noted on the thread's task{% elif t == "would note" %} · note on the thread's task (dry run){% elif t == "in calendar" %} · in the calendar, no task{% elif t == "event passed" %} · the event is past, no task{% endif %}
{%- endmacro %}

{% macro expiry(m) -%}
{% if m.expires %} ⏳ deleted {{ m.expires | date("%d %b") }}{% endif %}
{%- endmacro %}

{% macro due(m) -%}
{% if m.deadline %} **(due {{ m.deadline | date("%a %d %b") }})**{% endif %}
{%- endmacro %}

{% macro todo(m, uid=true, category=true) -%}
- [ ] {% if m.sensitive %}🔒 {% endif %}{{ m.todo }}{{ due(m) }}{{ expiry(m) }} — {% if category %}{{ m.category }}, {% endif %}{{ m.sender }}{% if uid %}, uid {{ m.uid }}{% endif %}{{ task_note(m.task, earlier=m.earlier) }}
{%- endmacro %}

{% macro event(m) -%}
- {{ m.event.date | date("%a %d %b") }}{% if m.event.start %} {{ m.event.start }}{% if m.event.end %}–{{ m.event.end }}{% endif %}{% endif %}: {{ m.event.title }}{% if m.event.place %} ({{ m.event.place }}){% endif %} — {{ m.sender }}, uid {{ m.uid }}{{ event_note(m.event_status, m.event_other) }}
{%- endmacro %}

{% macro event_note(s, other=none) -%}
{% if s == "added" %} · added (tentative){% if other %}; another event starts at the same time: '{{ other }}'{% endif %}{% elif s == "yours" %} · you already have '{{ other }}' at that time{% elif s == "merged" %} · added to '{{ other }}' at the same time{% elif s == "exists" %} · already in the calendar{% if other %} as '{{ other }}'{% endif %}{% elif s == "failed" %} · not added (error){% endif %}
{%- endmacro %}

{% macro waiting(s) -%}
- **{{ s.subject }}** — {{ s.to }}, {{ s.days }} days: {{ s.waiting_for }}{{ task_note(s.task, true) }}
{%- endmacro %}

{% macro problems(ctx_problems, task_error) -%}
{% if task_error %}
Taskwarrior failed, no tasks were added: {{ task_error }}

{% endif %}
{% for p in ctx_problems %}
**Problem:** {{ p }}

{% endfor %}
{%- endmacro %}

{% macro counts(d) -%}
{% for c, n in d.items() %}{{ c }} {{ n }}{{ ", " if not loop.last }}{% endfor %}
{%- endmacro %}
